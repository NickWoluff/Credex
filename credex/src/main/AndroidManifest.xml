<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:alwaysRetainTaskState="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WidgetSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WidgetUiSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ThemeSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".AboutActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ProjectsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ReferencesActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".HelpActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".DisclaimerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ServiceConfigurationActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CodexLoginActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".SiliconFlowLoginActivity"
            android:exported="false"
            android:label="SiliconFlow 登录"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MimoLoginActivity"
            android:exported="false"
            android:label="MIMO 登录"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ConsoleLoginActivity"
            android:exported="false"
            android:label="平台登录"
            android:screenOrientation="portrait" />
        <activity
            android:name=".KimiLoginActivity"
            android:exported="false"
            android:label="Kimi 登录"
            android:screenOrientation="portrait" />
        <provider
            android:name=".QuotaProvider"
            android:authorities="com.nickwoluff.credex"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <service
            android:name=".QuotaRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".QuotaForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled periodic Codex quota synchronization for rear display and home-screen widget" />
        </service>
        <receiver
            android:name=".QuotaAppWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quota_appwidget_info" />
        </receiver>
        <receiver android:name=".QuotaRefreshBootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
